{
  "schemaVersion": 1,
  "kind": "mcp",
  "id": "tavily",
  "name": "Tavily",
  "description": "Real-time web search, extraction and site mapping with the Tavily API.",
  "vendor": "Tavily",
  "homepage": "https://github.com/tavily-ai/tavily-mcp",
  "repository": "tavily-ai/tavily-mcp",
  "license": "MIT",
  "isOfficial": true,
  "version": "0.2.22",
  "tags": [
    "search",
    "web",
    "research"
  ],
  "transport": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "tavily-mcp@latest"
    ],
    "env": {
      "TAVILY_API_KEY": "${TAVILY_API_KEY}"
    }
  },
  "requiredEnv": [
    "TAVILY_API_KEY"
  ],
  "readme": {
    "type": "github",
    "source": "tavily-ai/tavily-mcp"
  }
}
