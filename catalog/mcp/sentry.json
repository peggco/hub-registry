{
  "schemaVersion": 1,
  "kind": "mcp",
  "id": "sentry",
  "name": "Sentry",
  "description": "Search issues and events, inspect stack traces and manage Sentry projects.",
  "vendor": "Sentry",
  "homepage": "https://docs.sentry.io/product/sentry-mcp/",
  "repository": "getsentry/sentry-mcp",
  "license": "Apache-2.0",
  "isOfficial": true,
  "version": "0.1.0",
  "tags": ["sentry", "errors", "observability"],
  "transport": {
    "type": "http",
    "url": "https://mcp.sentry.dev/mcp",
    "headers": { "Authorization": "Bearer ${SENTRY_AUTH_TOKEN}" }
  },
  "requiredEnv": ["SENTRY_AUTH_TOKEN"],
  "readme": { "type": "github", "source": "getsentry/sentry-mcp" }
}
