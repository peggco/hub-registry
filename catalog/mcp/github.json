{
  "schemaVersion": 1,
  "kind": "mcp",
  "id": "github",
  "name": "GitHub",
  "description": "Issues, pull requests, repositories and code search through the official GitHub server.",
  "vendor": "GitHub",
  "homepage": "https://github.com/github/github-mcp-server",
  "repository": "github/github-mcp-server",
  "license": "MIT",
  "isOfficial": true,
  "tags": [
    "git",
    "issues",
    "pull-requests",
    "code-search"
  ],
  "transport": {
    "type": "http",
    "url": "https://api.githubcopilot.com/mcp/",
    "headers": {
      "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
    }
  },
  "requiredEnv": [
    "GITHUB_PERSONAL_ACCESS_TOKEN"
  ],
  "readme": {
    "type": "github",
    "source": "github/github-mcp-server"
  }
}
