{
  "schemaVersion": 1,
  "kind": "mcp",
  "id": "postgres",
  "name": "PostgreSQL",
  "description": "Query a PostgreSQL database with read-only tools for schema and data inspection.",
  "vendor": "Postgres MCP Pro",
  "homepage": "https://github.com/crystaldba/postgres-mcp",
  "repository": "crystaldba/postgres-mcp",
  "license": "MIT",
  "isOfficial": false,
  "version": "0.3.0",
  "tags": [
    "database",
    "postgres",
    "sql"
  ],
  "transport": {
    "type": "stdio",
    "command": "uvx",
    "args": [
      "postgres-mcp",
      "--access-mode=restricted"
    ],
    "env": {
      "DATABASE_URI": "${DATABASE_URI}"
    }
  },
  "requiredEnv": [
    "DATABASE_URI"
  ],
  "readme": {
    "type": "github",
    "source": "crystaldba/postgres-mcp"
  }
}
