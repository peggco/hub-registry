{
  "schemaVersion": 1,
  "kind": "mcp",
  "id": "git",
  "name": "Git",
  "description": "Inspect local repositories, branches, commits and diffs without leaving the agent.",
  "vendor": "Model Context Protocol",
  "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/git",
  "repository": "modelcontextprotocol/servers",
  "license": "MIT",
  "isOfficial": true,
  "version": "2025.1.0",
  "tags": ["git", "local", "version-control"],
  "transport": {
    "type": "stdio",
    "command": "uvx",
    "args": ["mcp-server-git", "--repository", "${REPOSITORY}"]
  },
  "requiredEnv": ["REPOSITORY"],
  "readme": { "type": "github", "source": "modelcontextprotocol/servers" }
}
